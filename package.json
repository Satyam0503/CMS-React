{
  "name": "demo1",
  "private": true,
  "version": "8.2.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:live": "BASE_URL=https://depapp.codeji.in API_URL=https://depapi.codeji.in playwright test",
    "test:e2e:live:smoke": "BASE_URL=https://depapp.codeji.in API_URL=https://depapi.codeji.in playwright test --grep @smoke",
    "test:e2e:report": "playwright show-report ../qa/reports/playwright",
    "test:security": "playwright test e2e/security/",
    "test:security:live": "BASE_URL=https://depapp.codeji.in API_URL=https://depapi.codeji.in playwright test e2e/security/",
    "format": "prettier --write ."
  },
  "dependencies": {
